<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PauseResumeAudioFade</AssemblyName>
    <Version>1.0.3</Version>
    <!-- exe(エクスプローラー/タスクバー)のアイコン。実行時にトレイと案内画面でも同じものを使う -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>PauseResumeAudioFade.App</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- WasapiLoopbackCapture/WasapiOutは新APIへの移行推奨の警告が出るが、現状の用途では問題ないので抑制 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PauseResumeAudioFade.Core\PauseResumeAudioFade.Core.csproj" />
  </ItemGroup>

</Project>
